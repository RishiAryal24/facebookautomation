# PyLoom Facebook Automation System Configuration

# Application security: generate unique values before starting the backend.
ENVIRONMENT=development
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
ENCRYPTION_KEY=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Database
DATABASE_URL=sqlite+aiosqlite:///./facebook_automation.db

# Google Gemini API Key (Bilingual comment replies and sentiment analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Explicitly enables labelled local templates; disable to require Gemini.
ENABLE_LOCAL_AI_FALLBACK=true

# Meta / Facebook Graph API Credentials (AUTIMATION CASE)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_AD_ACCOUNT_ID=
META_AD_ACCESS_TOKEN=
META_AD_CURRENCY=NPR
META_AD_ACCOUNT_TIMEZONE=Asia/Kathmandu

# Simulation Mode (Allows full end-to-end testing without live Facebook app)
SIMULATION_MODE=true

# Automation Defaults
DEFAULT_OPERATING_HOURS_START=08:00
DEFAULT_OPERATING_HOURS_END=22:00
DEFAULT_RATE_LIMIT_PER_HOUR=30
DEFAULT_TIMEZONE=Asia/Kathmandu
SCHEDULER_MAX_ATTEMPTS=3

# Comma-separated JSON list is accepted by pydantic-settings for this value.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
